# InsightFlow AI — local development environment template
# Copy to `.env` and adjust values. Never commit real secrets.
# The app auto-loads `.env` from the project root (or current working directory)
# when started normally (python -m insightflow).

# Application
INSIGHTFLOW_ENV=development
INSIGHTFLOW_LOG_LEVEL=INFO
INSIGHTFLOW_LOG_CONSOLE=true
INSIGHTFLOW_LOG_FILE=true
INSIGHTFLOW_LOG_MAX_BYTES=5000000
INSIGHTFLOW_LOG_BACKUP_COUNT=3

# Local data directories (absolute paths). Leave empty to use platform defaults:
# Windows: %LOCALAPPDATA%\InsightFlow
# macOS: ~/Library/Application Support/InsightFlow
# Linux: ~/.local/share/InsightFlow
# INSIGHTFLOW_DATA_DIR=
# INSIGHTFLOW_LOG_DIR=

# Secret store backend:
#   memory      - ephemeral in-process store (development/testing only)
#   windows     - Windows Credential Manager via keyring (production)
#   unavailable - explicit refusal
INSIGHTFLOW_SECRET_STORE=memory

# Gmail OAuth client configuration (non-token). Prefer an absolute path to an
# untracked Desktop OAuth client JSON downloaded from Google Cloud Console:
# INSIGHTFLOW_GMAIL_CLIENT_SECRETS_FILE=C:\Users\you\secure\gmail-client-secret.json
# Or set client id/secret via env (do not commit real values):
# INSIGHTFLOW_GMAIL_CLIENT_ID=
# INSIGHTFLOW_GMAIL_CLIENT_SECRET=
# INSIGHTFLOW_GMAIL_OAUTH_PORT=0

# Gmail real-time monitoring (Phase 10). See
# docs/17_Phase10_Gmail_Realtime_Monitoring_Notes.md for the manual Google
# Cloud setup (Pub/Sub topic/subscription, Gmail publish permission). These
# identify resources you provision yourself — InsightFlow never creates
# them and never stores Pub/Sub credentials here.
# INSIGHTFLOW_GMAIL_PUBSUB_PROJECT_ID=
# INSIGHTFLOW_GMAIL_PUBSUB_TOPIC=
# INSIGHTFLOW_GMAIL_PUBSUB_SUBSCRIPTION=

# Optional monitoring tuning (sensible defaults apply if unset):
# INSIGHTFLOW_MONITORING_HISTORY_BATCH_SIZE=50
# INSIGHTFLOW_MONITORING_HISTORY_PAGE_SIZE=100
# INSIGHTFLOW_MONITORING_FULL_SYNC_MAX_MESSAGES=50
# INSIGHTFLOW_MONITORING_WATCH_RENEWAL_MARGIN_HOURS=24
# INSIGHTFLOW_MONITORING_PULL_MAX_MESSAGES=10
# INSIGHTFLOW_MONITORING_IDLE_POLL_SECONDS=5

# AI analysis (Phase 11). Disabled by default — no AI calls, no AWS cost,
# until explicitly enabled. See docs/18_Phase11_AI_Analysis_and_Summary_Notes.md.
# INSIGHTFLOW_AI_ENABLED=false
# INSIGHTFLOW_AI_AUTOMATIC_ANALYSIS_ENABLED=true
# INSIGHTFLOW_AI_PROVIDER=bedrock
# INSIGHTFLOW_AI_REGION=us-east-1
# INSIGHTFLOW_AI_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# INSIGHTFLOW_AI_TIMEOUT_SECONDS=30
# INSIGHTFLOW_AI_MAX_RETRIES=2
# INSIGHTFLOW_AI_MAX_INPUT_CHARS=12000
# INSIGHTFLOW_AI_MAX_OUTPUT_TOKENS=1024
# INSIGHTFLOW_AI_TEMPERATURE=0.2
# INSIGHTFLOW_AI_QUEUE_MAX_SIZE=100

# Windows toast notifications (Phase 12). Enabled by default — a Windows
# toast popup appears for each new real-time Gmail event on a monitored
# Topic. Disabling this does not affect Gmail monitoring or AI analysis.
# See docs/20_Phase12_Windows_Toast_Notifications_Notes.md.
# INSIGHTFLOW_NOTIFICATIONS_ENABLED=true

# Secrets belong in a secure store, not ordinary configuration.
# Do not put production credentials or OAuth tokens in `.env`.
# AWS credentials for Bedrock are resolved via boto3's default credential
# chain (environment, shared config/credentials files, or an IAM role) —
# InsightFlow never reads, stores, or logs them. Set these only if you rely
# on environment-variable-based AWS credentials for local development:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
